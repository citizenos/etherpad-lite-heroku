.hg

# Remove the git objects, logs, etc. to make final image smaller.
# Some files still need to be in the .git directory, because Etherpad at
# startup uses them to discover its version number.
.git/branches
.git/COMMIT_EDITMSG
.git/config
.git/description
.git/FETCH_HEAD
.git/hooks
.git/index
.git/info
.git/logs
.git/objects
.git/ORIG_HEAD
.git/packed-refs
.git/refs/remotes/
.gitignore

settings.json
etherpad-lite/settings.json
etherpad-lite/APIKEY.txt
etherpad-lite/SESSIONKEY.txt
config/local.json
node_modules
src/node_modules
etherpad-lite/src/node_modules
etherpad-lite/admin/node_modules
etherpad-lite/ui/node_modules
etherpad-lite/bin/node_modules
etherpad-lite/doc/node_modules
etherpad-lite/src/plugin_packages
etherpad-lite/var

